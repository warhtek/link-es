# PostgreSQL local (docker-compose en la raíz del repo)
# Para producción usa la URL de Neon/Supabase (ej: postgresql://user:pass@host/db?schema=public)
DATABASE_URL="postgresql://link_es:link_es@localhost:5432/link_es?schema=public"

PORT=4000
HOST=0.0.0.0

# Orígenes permitidos para CORS (separados por coma)
# En producción: https://tu-proyecto.pages.dev,https://tudominio.com
CORS_ORIGIN=http://localhost:5173

# URL del frontend para enlaces en emails (reset password, etc.)
WEB_APP_URL=http://localhost:5173

# Secrets JWT (genera valores seguros en producción: openssl rand -base64 32)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Email (opcional - sin SMTP se loguea en consola)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-usuario
# SMTP_PASS=tu-password
# MAIL_FROM="Link-ES <no-reply@tudominio.com>"