// Modelo de datos inicial — plan-desarrollo-link-es.md sección 5.
// Cada cambio de modelo debe incluir migración + seed (sección 9.3 del plan).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
}

enum DocumentType {
  ID // DUI / identificación
  LICENSE
  CERTIFICATION
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceUnit {
  HOUR
  PROJECT
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  roles        Role[]
  activeMode   Role      @default(CLIENT)
  address      String?
  postalCode   String?
  city         String?
  lat          Float?
  lng          Float?
  locale       String?   // preferencia de idioma persistida ("es" | "en") cuando inicia sesión
  createdAt    DateTime  @default(now())
  verifiedAt   DateTime?

  providerProfile ProviderProfile?
  bookingsAsClient Booking[]       @relation("ClientBookings")
  reviews          Review[]
  conversationsAsClient Conversation[] @relation("ClientConversations")
  messages         Message[]
  addresses        Address[]

  @@map("users")
}

model ProviderProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  headline           String?
  bio                String?
  verificationStatus VerificationStatus @default(NONE)
  availableOnline    Boolean            @default(true)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  serviceAreaLat     Float?
  serviceAreaLng     Float?
  serviceRadiusKm    Float              @default(5)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories    Category[]
  services      Service[]
  documents     VerificationDocument[]
  subscription  Subscription?
  bookings      Booking[]              @relation("ProviderBookings")
  conversations Conversation[]         @relation("ProviderConversations")
  reviews       Review[]

  @@index([serviceAreaLat, serviceAreaLng])
  @@map("provider_profiles")
}

model VerificationDocument {
  id          String         @id @default(cuid())
  providerId  String
  type        DocumentType
  fileUrl     String
  status      DocumentStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime       @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  icon     String?
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  services Service[]
  profiles ProviderProfile[]

  @@map("categories")
}

model Service {
  id          String      @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String?
  priceFrom   Decimal     @db.Decimal(10, 2)
  unit        ServiceUnit @default(HOUR)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@map("services")
}

model Booking {
  id          String        @id @default(cuid())
  clientId    String
  providerId  String
  serviceId   String
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime
  address     String
  notes       String?
  createdAt   DateTime      @default(now())

  client   User            @relation("ClientBookings", fields: [clientId], references: [id])
  provider ProviderProfile @relation("ProviderBookings", fields: [providerId], references: [id])
  service  Service         @relation(fields: [serviceId], references: [id])
  review   Review?

  @@index([clientId, status])
  @@index([providerId, status])
  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  clientId   String
  providerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking         @relation(fields: [bookingId], references: [id])
  client   User            @relation(fields: [clientId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@map("reviews")
}

model Conversation {
  id          String   @id @default(cuid())
  clientId    String
  providerId  String
  bookingId   String?  @unique
  createdAt   DateTime @default(now())
  lastMessage DateTime?

  client    User            @relation("ClientConversations", fields: [clientId], references: [id])
  provider  ProviderProfile @relation("ProviderConversations", fields: [providerId], references: [id])
  messages  Message[]

  @@unique([clientId, providerId, bookingId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachments    String[]
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Subscription {
  id                  String             @id @default(cuid())
  providerId          String             @unique
  plan                Plan               @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd    DateTime?
  stripeSubscriptionId String?           @unique
  createdAt           DateTime           @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  address   String
  postalCode String?
  lat       Float
  lng       Float
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}
