generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  phone                 String?
  passwordHash          String
  avatarUrl             String?
  roles                 Role[]
  activeMode            Role                 @default(CLIENT)
  address               String?
  postalCode            String?
  city                  String?
  lat                   Float?
  lng                   Float?
  locale                String?
  createdAt             DateTime             @default(now())
  verifiedAt            DateTime?
  addresses             Address[]
  bookingsAsClient      Booking[]            @relation("ClientBookings")
  conversationsAsClient Conversation[]       @relation("ClientConversations")
  messages              Message[]
  passwordResetTokens   PasswordResetToken[]
  providerProfile       ProviderProfile?
  refreshTokens         RefreshToken[]
  reviews               Review[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ProviderProfile {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  businessName       String
  headline           String?
  bio                String?
  avatarUrl          String?                @db.VarChar(1000)
  galleryImages      String[]               @default([])
  verificationStatus VerificationStatus     @default(NONE)
  availableOnline    Boolean                @default(true)
  ratingAvg          Float                  @default(0)
  ratingCount        Int                    @default(0)
  serviceAreaLat     Float?
  serviceAreaLng     Float?
  serviceRadiusKm    Float                  @default(5)
  bookings           Booking[]              @relation("ProviderBookings")
  conversations      Conversation[]         @relation("ProviderConversations")
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews            Review[]
  services           Service[]
  subscription       Subscription?
  documents          VerificationDocument[]
  categories         Category[]             @relation("CategoryToProviderProfile")

  @@index([serviceAreaLat, serviceAreaLng])
  @@map("provider_profiles")
}

model VerificationDocument {
  id          String          @id @default(cuid())
  providerId  String
  type        DocumentType
  fileUrl     String
  status      DocumentStatus  @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime        @default(now())
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model Category {
  id       String            @id @default(cuid())
  name     String
  slug     String            @unique
  icon     String?
  parentId String?
  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  services Service[]
  profiles ProviderProfile[] @relation("CategoryToProviderProfile")

  @@map("categories")
}

model Service {
  id          String          @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String?
  priceFrom   Decimal?        @db.Decimal(10, 2)
  unit        ServiceUnit     @default(HOUR)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  bookings    Booking[]
  category    Category        @relation(fields: [categoryId], references: [id])
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Booking {
  id           String          @id @default(cuid())
  clientId     String
  providerId   String
  serviceId    String
  status       BookingStatus   @default(PENDING)
  scheduledAt  DateTime
  address      String
  notes        String?
  createdAt    DateTime        @default(now())
  code         String          @unique
  client       User            @relation("ClientBookings", fields: [clientId], references: [id])
  provider     ProviderProfile @relation("ProviderBookings", fields: [providerId], references: [id])
  service      Service         @relation(fields: [serviceId], references: [id])
  conversation Conversation?
  review       Review?

  @@index([clientId, status])
  @@index([providerId, status])
  @@map("bookings")
}

model Review {
  id         String          @id @default(cuid())
  bookingId  String          @unique
  clientId   String
  providerId String
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())
  booking    Booking         @relation(fields: [bookingId], references: [id])
  client     User            @relation(fields: [clientId], references: [id])
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  @@map("reviews")
}

model Conversation {
  id          String          @id @default(cuid())
  clientId    String
  providerId  String
  bookingId   String?         @unique
  createdAt   DateTime        @default(now())
  lastMessage DateTime?
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  client      User            @relation("ClientConversations", fields: [clientId], references: [id])
  provider    ProviderProfile @relation("ProviderConversations", fields: [providerId], references: [id])
  messages    Message[]

  @@unique([clientId, providerId, bookingId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachments    String[]
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Subscription {
  id                   String             @id @default(cuid())
  providerId           String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  provider             ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String
  address    String
  postalCode String?
  lat        Float
  lng        Float
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
}

enum DocumentType {
  ID
  LICENSE
  CERTIFICATION
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceUnit {
  HOUR
  PROJECT
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}
